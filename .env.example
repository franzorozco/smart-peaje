# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - SMART PEAJE
# Nunca subas archivos .env ni secretos reales al repositorio Git.
# ==============================================================================

# === 1. SERVICIO DE INFERENCIA (RunPod / Colab / inferencia/.env) ===
INFERENCE_TOKEN=generar-token-secreto-largo
# Modo: 'real' en producción (exige vehiculos.pt y ejes.pt), 'mock' solo para pruebas locales sin pesos
INFERENCE_MODE=real
INFERENCE_DEVICE=auto
MODELOS_DIR=inferencia/modelos
M2_MODEL_PATH=inferencia/modelos/vehiculos.pt
M2_MANIFEST_PATH=inferencia/modelos/vehiculos.manifest.json
M3_MODEL_PATH=inferencia/modelos/ejes.pt
M3_MANIFEST_PATH=inferencia/modelos/ejes.manifest.json
M4_MODEL_PATH=inferencia/modelos/pasajeros.pt
M4_MANIFEST_PATH=inferencia/modelos/pasajeros.manifest.json
MAX_EJES=7
CONF_M2=0.50
CONF_M2_RESCATE=0.25
IOU_M2=0.45
CONF_M2_COBRO=0.60
CONF_M3=0.25
CONF_KEYPOINT=0.55
IOU_ASOCIACION=0.50
PLACA_CONF=0.25
M4_HABILITADO=1
CONF_M4=0.30
IOU_M4=0.45
M4_MIN_OVERLAP_VEH=0.35
M4_MIN_OVERLAP_CABINA=0.20
M4_MIN_BRILLO_CABINA=55.0
M4_MIN_CONTRASTE_CABINA=20.0
M4_MAX_REFLEJO_RATIO=0.35
M4_MIN_CABIN_PX=48
MAX_IMAGEN_MB=8
# Opcional: URLs privadas o de Google Drive para descargar vehiculos.pt / ejes.pt / pasajeros.pt
M2_URL=
M3_URL=
M4_URL=

# === 2. BACKEND DJANGO (Render Web Service / web/backend/.env) ===
DJANGO_SECRET_KEY=generar-secret-key-django
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,peaje-backend.onrender.com
WEB_ORIGINS=http://localhost:5173,https://peaje-frontend.onrender.com
DATABASE_URL=postgres://user:pass@host:5432/dbname
GOOGLE_WEB_CLIENT_ID=tu-client-id-web.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=
INFERENCE_URL=https://tu-pod-8000.proxy.runpod.net/predict
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
ADMIN_EMAILS=doc.alvaro.pinto.ma@unifranz.edu.bo
OPERADOR_EMAILS=
GEMINI_API_KEY=

# === 3. FRONTEND REACT (Render Static Site / web/frontend/.env) ===
VITE_API_URL=https://peaje-backend.onrender.com/api/v1
VITE_GOOGLE_CLIENT_ID=tu-client-id-web.apps.googleusercontent.com
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=

# === 4. APLICACIÓN MÓVIL EXPO (EAS / movil/.env) ===
EXPO_PUBLIC_API_URL=https://peaje-backend.onrender.com/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=tu-client-id-web.apps.googleusercontent.com

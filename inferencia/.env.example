# Token obligatorio compartido con el backend Django (header X-Service-Token)
INFERENCE_TOKEN=generar-token-secreto-largo

# Modo de ejecución: 'real' (producción, exige vehiculos.pt y ejes.pt) o 'mock' (solo pruebas sin pesos)
INFERENCE_MODE=real

# Dispositivo: 'auto' (usa GPU CUDA 0 en RunPod si está disponible), '0' o 'cpu'
INFERENCE_DEVICE=auto

# Rutas configurables de pesos entrenados y manifiestos
MODELOS_DIR=inferencia/modelos
M2_MODEL_PATH=inferencia/modelos/vehiculos.pt
M2_MANIFEST_PATH=inferencia/modelos/vehiculos.manifest.json
M3_MODEL_PATH=inferencia/modelos/ejes.pt
M3_MANIFEST_PATH=inferencia/modelos/ejes.manifest.json
M4_MODEL_PATH=inferencia/modelos/pasajeros.pt
M4_MANIFEST_PATH=inferencia/modelos/pasajeros.manifest.json

# Esquema máximo de ejes según el dataset M3 convertido (kpt_shape: [7, 3])
MAX_EJES=7

# Umbrales iniciales sujetos a calibración (M2, M3 y M4)
CONF_M2=0.50
CONF_M2_RESCATE=0.25
IOU_M2=0.45
CONF_M2_COBRO=0.60
CONF_M3=0.25
CONF_KEYPOINT=0.55
IOU_ASOCIACION=0.50
PLACA_CONF=0.25

# M4: Conteo anónimo de pasajeros visibles con YOLOv8n-seg COCO person (ID 0)
M4_HABILITADO=1
CONF_M4=0.30
IOU_M4=0.45
M4_MIN_OVERLAP_VEH=0.35
M4_MIN_OVERLAP_CABINA=0.20
M4_MIN_BRILLO_CABINA=55.0
M4_MIN_CONTRASTE_CABINA=20.0
M4_MAX_REFLEJO_RATIO=0.35
M4_MIN_CABIN_PX=48

# Límite de tamaño de imagen en MB
MAX_IMAGEN_MB=8

# Opcional: URLs privadas o Google Drive para descargar_modelos.py
M2_URL=
M3_URL=
M4_URL=
